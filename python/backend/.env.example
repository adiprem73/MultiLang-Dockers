# Supabase project credentials (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Comma separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000

PORT=5000

# Max wall-clock time for a single cell execution
EXEC_TIMEOUT_MS=60000

# Kernels are shut down after this much inactivity
SESSION_IDLE_MS=1800000

# Container images used per language
PYTHON_IMAGE=python:3.11-slim
NODE_IMAGE=node:22
CPP_IMAGE=gcc:14
JAVA_IMAGE=amazoncorretto:21

# Resource caps applied to every execution container
CONTAINER_MEMORY=512m
CONTAINER_CPUS=1

# Python/JS kernels get network access so `!pip install` / `require` of installed
# packages work. Set to false to fully sandbox them.
KERNEL_NETWORK=true
